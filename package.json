{
  "name": "m3o.sh",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "bun run generate-types && lefthook install && playwright install",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "bun test --path-ignore-patterns e2e",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "astro": "astro",
    "pulumi": "cd infra && pulumi",
    "lint": "biome check .",
    "format": "biome check --fix --unsafe .",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "14.1.5",
    "@astrojs/mdx": "7.0.4",
    "@astrojs/solid-js": "7.0.1",
    "@pulumi/pulumi": "^3.254.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.1.4",
    "hls.js": "^1.6.16",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.114.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.62.0",
    "@pulumi/cloudflare": "^6.18.0",
    "@pulumi/command": "^1.2.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "daisyui": "^5.7.4",
    "lefthook": "^2.1.10",
    "playwright": "^1.62.0",
    "typescript": "^7.0.2"
  }
}
