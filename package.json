{
  "name": "m3o.sh",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "bun run generate-types && lefthook install && playwright install",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "bun test --path-ignore-patterns e2e",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "astro": "astro",
    "pulumi": "cd infra && pulumi",
    "lint": "biome check .",
    "format": "biome check --fix --unsafe .",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/solid-js": "7.0.2",
    "@pulumi/pulumi": "^3.262.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.2",
    "hls.js": "^1.7.2",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.130.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@pulumi/cloudflare": "^6.20.0",
    "@pulumi/command": "^1.2.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "daisyui": "^5.7.34",
    "lefthook": "^2.1.12",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
