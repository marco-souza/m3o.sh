{
  "name": "m3o.sh",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "bun run generate-types && lefthook install && playwright install",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "bun test --path-ignore-patterns e2e",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "astro": "astro",
    "pulumi": "cd infra && pulumi",
    "lint": "biome check .",
    "format": "biome check --fix --unsafe .",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/solid-js": "7.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@pulumi/pulumi": "3.272.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.2",
    "hls.js": "^1.7.3",
    "hono": "^4.13.13",
    "posthog-js": "^1.438.21",
    "posthog-node": "^5.57.1",
    "solid-js": "^1.9.17",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.152.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@pulumi/cloudflare": "^6.23.1",
    "@pulumi/command": "^1.2.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "daisyui": "^5.7.50",
    "lefthook": "^2.2.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
