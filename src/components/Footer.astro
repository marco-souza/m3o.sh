---
import { getLangFromUrl, useTranslations } from "@/i18n/ui";
import { replaceLinks } from "@/lib/formatters";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const repoUrl = "https://github.com/marco-souza/m3o.sh";
const linksMap = {
  year: new Date().getFullYear().toString(),
  oss: `<a class="link decoration-accent hover:link-accent" href="${repoUrl}" target="_blank">Open Source</a>`,
};
---
<footer id="footer" class="text-center text-sm">
  <Fragment set:html={replaceLinks(t('footer.built-by'), linksMap)} />
</footer>
