---
import { getLangFromUrl, useTranslations } from "@/i18n/ui";
import { replaceLinks } from "@/lib/formatters";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const baseUrl = "https://m3o.sh";
const linksMap = {
  MongoDB: `<a class="link decoration-primary hover:link-primary" href="https://mongodb.com" target="_blank">MongoDB</a>`,
  PodCodar: `<a class="link decoration-primary hover:link-primary" href="https://podcodar.org" target="_blank">PodCodar</a>`,
  newsletter: `<a class="link decoration-primary hover:link-primary" href="${baseUrl}/newsletter">newsletter</a>`,
};
---
<section id="presentation" class="grid gap-4">
  <p>{t('home.presentation.title')}</p>

  <p set:html={replaceLinks(t('home.presentation.description'), linksMap)} />

  <p set:html={replaceLinks(t('home.presentation.subscribe'), linksMap)} />
</section>
