---
import { navLinks } from "@/config/links";

const { pathname } = Astro.url;
---

<nav class="top-2 p-2 text-center sticky z-10 backdrop-blur-md bg-base-100/30 rounded-xl shadow-sm">
  {navLinks.map(({ label, url }) => (
    <a
      href={url}
      class={`btn btn-ghost btn-xs ${pathname == url ? "underline" : ""}`}
    >
      {label}
    </a>
  ))}
</nav>
