---
import { m3o } from "@/config/links";

type Props = {
  title: string;
  subtitle: string;
  image?: string;
};

const { title, subtitle, image = m3o.avatar } = Astro.props;
---
<section id="hero" class="flex flex-col md:flex-row items-center gap-2 md:px-4">
  <div class="grid gap-2 text-center md:text-left md:max-w-96">
    <h1 class="text-4xl md:text-5xl">{title}</h1>
    <h2 class="text-2xl text-gray-400">{subtitle}</h2>
  </div>

  <a href="/">
    <img src={image} alt="It's me!" class="rounded-full shadow-lg hover:animate-pulse" width="200" height="200" />
  </a>
</section>
