---
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "@/i18n/ui";
import Layout from "@/layouts/Layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = t("blog.meta.title");
const description = t("blog.meta.description");

const allBlogPosts = await getCollection("blog");

console.log({
  data: allBlogPosts.map(({ data }) => data.author),
});
---

<Layout title={title} subtitle={description}>
  <ul class="grid gap-12">
    {allBlogPosts.map((post) => (
      <a href={`/blog/${post.id}`} >
        <li class="grid gap-2 group/post">
          <h3 class="group-hover/post:underline"># {post.data.title} - <span class="italic">{post.data.publishedAt.toLocaleDateString()}</span></h3>

          <p>{post.data.description}</p>

          <p class="tags text-xs flex gap-2">
            {post.data.tags.map(tab => (
              <span class="group-hover/post:underline">#{tab}</span>
            ))}
          </p>
        </li>
      </a>
    ))}
  </ul>
</Layout>
