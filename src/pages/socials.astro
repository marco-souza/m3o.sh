---
import { m3o, podcodar } from "@/config/links";
import { getLangFromUrl, useTranslations } from "@/i18n/ui";
import Layout from "@/layouts/Layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = t("socials.meta.title");
const description = t("socials.meta.description");

const socials = [
  {
    label: t("social.github"),
    handle: m3o.github.replace("https://", ""),
    url: m3o.github,
    icon: "github",
  },
  {
    label: t("social.linkedin"),
    handle: m3o.linkedin.replace("https://", ""),
    url: m3o.linkedin,
    icon: "linkedin",
  },
];
---

<Layout title={title} subtitle={description}>
  <section class="flex flex-col gap-4">
    <h2 class="text-2xl font-bold">{t("socials.heading")}</h2>
    <p>{t("socials.intro")}</p>
  </section>

  <ul class="flex flex-col gap-2 list-disc pl-5">
    {socials.map(({ label, handle, url }) => (
      <li>
        <span>{label}: </span>
        <a href={url} target="_blank" class="link">{handle}</a>
      </li>
    ))}
  </ul>

  <p class="text-sm opacity-70">{t("socials.note")}</p>

  <div class="flex flex-wrap gap-2 justify-center">
    <a href={podcodar.page} target="_blank" class="btn btn-primary btn-sm">
      {t("socials.cta.page")}
    </a>
    <a href={podcodar.discord} target="_blank" class="btn btn-outlined btn-sm">
      {t("socials.cta.discord")}
    </a>
  </div>
</Layout>
